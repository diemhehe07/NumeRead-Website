rules_version = '2';

// Students are private to their owner and the verified teacher assigned to
// that exact section. A verified teacher's own profile is the authority; no
// administrator-issued custom claim is required.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedEmail() { return signedIn() && request.auth.token.email_verified == true; }
    function profile() { return get(/databases/$(database)/documents/teacherAccounts/$(request.auth.uid)); }
    function isTeacher() {
      return verifiedEmail() &&
        exists(/databases/$(database)/documents/teacherAccounts/$(request.auth.uid)) &&
        profile().data.uid == request.auth.uid && profile().data.role == 'teacher';
    }
    function sectionTeacher(section) { return isTeacher() && profile().data.section == section; }
    function text(value, limit) { return value is string && value.size() <= limit; }
    function validItemSet(item) {
      return item is map &&
        item.keys().hasOnly(['topic', 'subtopic', 'itemSetId', 'generatedAt', 'status']) &&
        item.keys().hasAll(['topic', 'subtopic', 'itemSetId', 'generatedAt', 'status']) &&
        text(item.topic, 40) && text(item.subtopic, 80) && text(item.itemSetId, 180) &&
        text(item.generatedAt, 40) && item.status == 'assigned';
    }
    function validPersonalizedActivities(data) {
      return !('personalizedActivities' in data) ||
        (data.personalizedActivities is map &&
          data.personalizedActivities.keys().hasOnly(['spelling-sprint', 'reading-bridge', 'sentence-builder', 'pronunciation-practice', 'vocab-quest', 'comprehension-trail', 'math-ninja', 'subtraction-sprint', 'division-dash', 'word-bakery', 'place-value-builder', 'fraction-pizza']) &&
          (!('spelling-sprint' in data.personalizedActivities) || validItemSet(data.personalizedActivities['spelling-sprint'])) &&
          (!('reading-bridge' in data.personalizedActivities) || validItemSet(data.personalizedActivities['reading-bridge'])) &&
          (!('sentence-builder' in data.personalizedActivities) || validItemSet(data.personalizedActivities['sentence-builder'])) &&
          (!('pronunciation-practice' in data.personalizedActivities) || validItemSet(data.personalizedActivities['pronunciation-practice'])) &&
          (!('vocab-quest' in data.personalizedActivities) || validItemSet(data.personalizedActivities['vocab-quest'])) &&
          (!('comprehension-trail' in data.personalizedActivities) || validItemSet(data.personalizedActivities['comprehension-trail'])) &&
          (!('math-ninja' in data.personalizedActivities) || validItemSet(data.personalizedActivities['math-ninja'])) &&
          (!('subtraction-sprint' in data.personalizedActivities) || validItemSet(data.personalizedActivities['subtraction-sprint'])) &&
          (!('division-dash' in data.personalizedActivities) || validItemSet(data.personalizedActivities['division-dash'])) &&
          (!('word-bakery' in data.personalizedActivities) || validItemSet(data.personalizedActivities['word-bakery'])) &&
          (!('place-value-builder' in data.personalizedActivities) || validItemSet(data.personalizedActivities['place-value-builder'])) &&
          (!('fraction-pizza' in data.personalizedActivities) || validItemSet(data.personalizedActivities['fraction-pizza'])));
    }
    function validAssessmentFocus(data) {
      return !('assessmentFocus' in data) ||
        (data.assessmentFocus is map && data.assessmentFocus.keys().hasOnly(['topic', 'subtopic', 'assessedAt']) &&
          data.assessmentFocus.keys().hasAll(['topic', 'subtopic', 'assessedAt']) && text(data.assessmentFocus.topic, 40) &&
          text(data.assessmentFocus.subtopic, 80) && text(data.assessmentFocus.assessedAt, 40));
    }
    function changesTeacherAssignments() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['personalizedActivities', 'assessmentFocus', 'assignedPath']);
    }
    function validTeacher(data) {
      return data.keys().hasOnly(['uid', 'name', 'section', 'role', 'createdAt', 'createdAtServer']) &&
        data.uid == request.auth.uid && data.role == 'teacher' && text(data.name, 80) &&
        text(data.section, 40) && text(data.createdAt, 40);
    }
    function validStudent(data) {
      return data.keys().hasOnly(['id', 'studentId', 'sectionNumber', 'ownerId', 'name', 'firstName', 'lastName', 'middleInitial', 'grade', 'gradeSection', 'section', 'xp', 'streak', 'badges', 'reading', 'math', 'wpm', 'mastery', 'gaps', 'activities', 'materialsCompleted', 'learningProgress', 'personalizedActivities', 'assessmentFocus', 'pretest', 'posttest', 'assignedPath', 'createdAt', 'updatedAt', 'createdAtServer', 'updatedAtServer']) &&
        data.keys().hasAll(['id', 'studentId', 'sectionNumber', 'ownerId', 'name', 'section', 'grade']) &&
        data.ownerId is string && data.ownerId.size() >= 20 && data.ownerId.size() <= 128 &&
        text(data.id, 100) && data.studentId is string && data.studentId.matches('^STU-[0-9]{5}$') &&
        data.sectionNumber is int && data.sectionNumber >= 1 && data.sectionNumber <= 99999 &&
        text(data.name, 100) && text(data.section, 40) && text(data.grade, 40) &&
        (!('firstName' in data) || text(data.firstName, 60)) && (!('lastName' in data) || text(data.lastName, 60)) &&
        (!('middleInitial' in data) || text(data.middleInitial, 2)) && (!('gradeSection' in data) || text(data.gradeSection, 40)) &&
        (!('xp' in data) || (data.xp is number && data.xp >= 0 && data.xp <= 1000000)) &&
        (!('reading' in data) || (data.reading is number && data.reading >= 0 && data.reading <= 100)) &&
        (!('math' in data) || (data.math is number && data.math >= 0 && data.math <= 100)) &&
        validPersonalizedActivities(data) && validAssessmentFocus(data);
    }

    match /teacherAccounts/{uid} {
      // Email verification is enforced when the profile is used as authority;
      // allowing its one-time self-owned creation lets a new teacher request it.
      allow create: if signedIn() && uid == request.auth.uid && validTeacher(request.resource.data);
      allow get: if signedIn() && uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /students/{studentId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && validStudent(request.resource.data);
      allow get: if signedIn() && (resource.data.ownerId == request.auth.uid || sectionTeacher(resource.data.section));
      allow list: if isTeacher() && sectionTeacher(resource.data.section);
      allow update: if validStudent(request.resource.data) && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.section == resource.data.section &&
        (sectionTeacher(resource.data.section) || (resource.data.ownerId == request.auth.uid && !changesTeacherAssignments()));
      allow delete: if false;
    }

    match /sectionCounters/{sectionId} {
      // A transaction allocates the next number while it creates the student.
      // Counter documents contain no learner data.
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['section', 'nextStudentNumber', 'updatedAt']) &&
        text(request.resource.data.section, 40) && request.resource.data.nextStudentNumber == 2;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['section', 'nextStudentNumber', 'updatedAt']) &&
        request.resource.data.section == resource.data.section &&
        request.resource.data.nextStudentNumber == resource.data.nextStudentNumber + 1;
      allow list, delete: if false;
    }

    match /learningMaterials/{id} {
      // Materials contain only teacher-approved instructional content. Signed-in
      // learners need read access to open their assigned learning resources.
      allow read: if signedIn();
      allow create: if isTeacher() && request.resource.data.teacherUid == request.auth.uid && request.resource.data.section == profile().data.section && text(request.resource.data.title, 160) && text(request.resource.data.content, 5000);
      allow update: if isTeacher() && ('teacherUid' in resource.data) && resource.data.teacherUid == request.auth.uid;
      allow delete: if isTeacher() && (
        (('teacherUid' in resource.data) && resource.data.teacherUid == request.auth.uid) ||
        // Cleanup access for materials created before teacherUid existed.
        // It is limited to a teacher whose verified profile has the same section.
        (!('teacherUid' in resource.data) && resource.data.section == profile().data.section)
      );
    }

    // Audit logs must be written only by trusted server code (Cloud Functions).
    match /pretestResults/{id} { allow read, write: if false; }
    match /activityLogs/{id} { allow read, write: if false; }
    match /teacherActions/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
