rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function verifiedTeacher() {
      return signedIn() && request.auth.token.email_verified == true &&
        firestore.exists(/databases/(default)/documents/teacherAccounts/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/teacherAccounts/$(request.auth.uid)).data.role == 'teacher';
    }

    match /learningMaterials/{teacherUid}/{materialId}/{fileName} {
      allow read: if signedIn();
      allow create, update, delete: if verifiedTeacher() && teacherUid == request.auth.uid &&
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('^(video|audio|text)/.*|application/pdf$');
    }
  }
}
