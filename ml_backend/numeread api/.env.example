# NumeRead Backend Environment Variables
# Copy this file to .env for local configuration

# Firebase Credentials:
# Option 1: File path to service account key (default is ./firebase_credentials/serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase_credentials/serviceAccountKey.json

# Option 2: Raw JSON string of the service account key (recommended for cloud deployments like Cloud Run, Render, Railway)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option 3: Standard Google Cloud Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Project Settings
FIREBASE_PROJECT_ID=numeread-webapp
PORT=8000
HOST=127.0.0.1
