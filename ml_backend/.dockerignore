# Ignore sensitive credentials and temporary files
**/serviceAccountKey*.json
**/service-account*.json
**/firebase_credentials/*.json
!**/firebase_credentials/serviceAccountKey.example.json
*.pem
*.key
.env
.env.*
!.env.example

# Ignore Python artifacts
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
**/venv/
**/.venv/
**/env/
.pytest_cache/
.coverage
htmlcov/
*.sqlite
*.sqlite3
.git
.gitignore
